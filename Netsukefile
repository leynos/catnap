netsuke_version: "1.0.0"

actions:
  - name: all
    description: Run comprehensive checks sequentially
    deps:
      - check-fmt
      - lint
      - test
      - spelling
      - test-workflow-contracts
    dependency_order: serial

  - name: install-build-tools
    description: Install the pinned development toolchain and mold
    command: scripts/install-build-tools.sh

  - name: install-cranelift
    description: Install Cranelift for the pinned nightly toolchain
    command: scripts/install-build-tools.sh --cranelift-only

  - name: check-build-tools
    description: Check the pinned development toolchain and linker
    command: 'PATH="${BUILD_TOOLS_PREFIX:-$HOME/.local}/bin:$PATH" scripts/check-build-tools.sh'

  - name: check-rust-toolchain
    description: Check the pinned Rust toolchain and components
    command: 'PATH="${BUILD_TOOLS_PREFIX:-$HOME/.local}/bin:$PATH" scripts/check-build-tools.sh --toolchain-only'

  - name: check-coverage-tools
    description: Check the coverage toolchain and LLVM linkers
    command: 'PATH="${BUILD_TOOLS_PREFIX:-$HOME/.local}/bin:$PATH" scripts/check-build-tools.sh --coverage-only'

  - name: clean
    description: Remove build artefacts
    command: "cargo clean"

  - name: test
    description: Run tests with cargo-nextest or Cargo
    deps:
      - check-build-tools
    command:
      - >-
        RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-D warnings -Zthreads=8
        -Zcodegen-backend=cranelift$(if [ "${BUILD_HOST_OS:-$(uname -s)}" = Linux ]; then
        printf ' -Clink-arg=-fuse-ld=mold'; fi)"
        PATH="${BUILD_TOOLS_PREFIX:-$HOME/.local}/bin:$PATH"
        cargo {% if command_available("cargo-nextest", cwd_mode="never") %}nextest run{% else %}test{% endif %}
        --all-targets --all-features
      - >-
        if command -v cargo-nextest >/dev/null 2>&1; then
        RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-D warnings -Zthreads=8
        -Zcodegen-backend=cranelift$(if [ "${BUILD_HOST_OS:-$(uname -s)}" = Linux ]; then
        printf ' -Clink-arg=-fuse-ld=mold'; fi)"
        PATH="${BUILD_TOOLS_PREFIX:-$HOME/.local}/bin:$PATH"
        cargo test --workspace --doc --all-features; fi

  - name: test-ui
    description: Run public error UI contract tests
    deps:
      - check-build-tools
    command: >-
      RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-D warnings -Zthreads=8
      -Zcodegen-backend=cranelift$(if [ "${BUILD_HOST_OS:-$(uname -s)}" = Linux ]; then
      printf ' -Clink-arg=-fuse-ld=mold'; fi)"
      PATH="${BUILD_TOOLS_PREFIX:-$HOME/.local}/bin:$PATH"
      cargo {% if command_available("cargo-nextest", cwd_mode="never") %}nextest run{% else %}test{% endif %}
      --test ui

  - name: build
    description: Build the debug binary
    deps:
      - check-build-tools
    command: >-
      RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-Zthreads=8
      -Zcodegen-backend=cranelift$(if [ "${BUILD_HOST_OS:-$(uname -s)}" = Linux ]; then
      printf ' -Clink-arg=-fuse-ld=mold'; fi)"
      PATH="${BUILD_TOOLS_PREFIX:-$HOME/.local}/bin:$PATH"
      cargo build --bin catnap

  - name: release
    description: Build the release binary with stable Rust
    command: 'RUSTFLAGS="" cargo +stable build --release --bin catnap'

  - name: coverage
    description: Generate lcov coverage with lld
    deps:
      - check-coverage-tools
    command:
      - 'echo "coverage linker flags: -fuse-ld=lld"'
      - >-
        CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=clang
        RUSTFLAGS="-D warnings -C link-arg=-fuse-ld=lld"
        CFLAGS="-fuse-ld=lld"
        LDFLAGS="-fuse-ld=lld"
        cargo llvm-cov --lcov --output-path lcov.info
        --all-targets --all-features

  - name: lint
    description: Run Rust and GitHub Actions linters
    deps:
      - check-build-tools
      - rust-lint
      - github-actions-lint
    dependency_order: serial

  - name: rust-lint
    description: Run rustdoc, Clippy, and Whitaker
    command:
      - >-
        RUSTDOCFLAGS="-D warnings"
        RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-Zthreads=8
        -Zcodegen-backend=cranelift$(if [ "${BUILD_HOST_OS:-$(uname -s)}" = Linux ]; then
        printf ' -Clink-arg=-fuse-ld=mold'; fi)"
        PATH="${BUILD_TOOLS_PREFIX:-$HOME/.local}/bin:$PATH"
        cargo doc --no-deps
      - >-
        RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-Zthreads=8
        -Zcodegen-backend=cranelift$(if [ "${BUILD_HOST_OS:-$(uname -s)}" = Linux ]; then
        printf ' -Clink-arg=-fuse-ld=mold'; fi)"
        PATH="${BUILD_TOOLS_PREFIX:-$HOME/.local}/bin:$PATH"
        cargo clippy --all-targets --all-features -- -D warnings
      - >-
        PATH="$PATH:$HOME/.cargo/bin:$HOME/.local/bin:$HOME/.bun/bin"
        RUSTFLAGS="-D warnings" whitaker --all --
        --all-targets --all-features

  - name: github-actions-lint
    description: Validate GitHub Actions workflows
    command:
      - '${YAMLLINT:-yamllint} .github/workflows'
      - '${ACTIONLINT:-actionlint}'

  - name: typecheck
    description: Type-check without building
    deps:
      - check-build-tools
    command: >-
      RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-D warnings -Zthreads=8
      -Zcodegen-backend=cranelift$(if [ "${BUILD_HOST_OS:-$(uname -s)}" = Linux ]; then
      printf ' -Clink-arg=-fuse-ld=mold'; fi)"
      PATH="${BUILD_TOOLS_PREFIX:-$HOME/.local}/bin:$PATH"
      cargo check --all-targets --all-features

  - name: fmt
    description: Format Rust and Markdown sources
    deps:
      - check-rust-toolchain
    command:
      - cargo fmt --all
      - >-
        mdtablefix --in-place --git --include-untracked
        --wrap --renumber --breaks --ellipsis --fences
      - 'bunx --silent markdownlint-cli2@0.23.3 --fix "**/*.md"'

  - name: check-fmt
    description: Verify formatting
    deps:
      - check-rust-toolchain
    command:
      - cargo fmt --all -- --check
      - >-
        mdtablefix --check --git --include-untracked
        --wrap --renumber --breaks --ellipsis --fences

  - name: markdownlint
    description: Lint Markdown files
    command: >-
      find . -type f -name "*.md"
      -not -path "./target/*"
      -not -path "./.uv-cache/*"
      -not -path "./.uv-tools/*"
      -print0 | xargs -0 bunx --silent markdownlint-cli2@0.23.3
    deps:
      - spelling

  - name: spelling
    description: Enforce en-GB-oxendict spelling
    command: >-
      UV_CACHE_DIR=.uv-cache UV_TOOL_DIR=.uv-tools
      uv tool run --python 3.14
      --from "git+https://github.com/leynos/typos-config-builder.git@v0.1.3"
      typos-config-builder gate --repository .

  - name: test-workflow-contracts
    description: Check the shared CV-005 workflow contracts
    command: >-
      UV_CACHE_DIR=.uv-cache UV_TOOL_DIR=.uv-tools
      uv tool run --python 3.13
      --from "git+https://github.com/leynos/shared-actions@a38feb9be25755c30eca5bda96bd3786a5b89c6b#subdirectory=packages/cv005-contracts"
      cv005-contracts check --repository .

  - name: nixie
    description: Validate Mermaid diagrams
    command: "nixie --no-sandbox"

targets: []

defaults:
  - all
